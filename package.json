{
  "name": "obsidian-formula-ai-writer",
  "version": "1.0.2",
  "description": "输入公式名称，用 AI 生成 LaTeX 公式并插入 Obsidian 笔记",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "bump": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "latex",
    "mathjax",
    "ai"
  ],
  "author": "YOUR NAME",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
